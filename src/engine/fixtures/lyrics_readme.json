    "lines": [
      {
        "startTimeMs": "4000",
        "endTimeMs": "8500",
        "words": "Amazing grace, how sweet the sound",
        "syllables": []
      },
      {
        "startTimeMs": "8500",
        "endTimeMs": "13000",
        "words": "That saved a wretch like me",
        "syllables": []
      },
      {
        "startTimeMs": "13000",
        "endTimeMs": "17500",
        "words": "I once was lost, but now am found",
        "syllables": []
      },
      {
        "startTimeMs": "17500",
        "endTimeMs": "21500",
        "words": "Was blind, but now I see",
        "syllables": []
      },
      {
        "startTimeMs": "21500",

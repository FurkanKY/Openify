        "words": "",
        "syllables": []
      },
      {
        "startTimeMs": "24000",
        "endTimeMs": "28500",
        "words": "'Twas grace that taught my heart to fear",
        "syllables": []
      },
      {
        "startTimeMs": "28500",
        "endTimeMs": "33000",
        "words": "And grace my fears relieved",
        "syllables": []
      },
      {
        "startTimeMs": "33000",
        "endTimeMs": "37500",
        "words": "How precious did that grace appear",
        "syllables": []
      },
      {
        "startTimeMs": "37500",
        "endTimeMs": "41500",
        "words": "The hour I first believed",
        "syllables": []
      },
      {
        "startTimeMs": "41500",
        "endTimeMs": "44000",
        "words": "",
        "syllables": []
      },
      {
        "startTimeMs": "44000",
        "endTimeMs": "48500",
        "words": "Through many dangers, toils and snares",
        "syllables": []
      },
      {
        "startTimeMs": "48500",
        "endTimeMs": "53000",
        "words": "I have already come",
        "syllables": []
      },
      {
        "startTimeMs": "53000",
        "endTimeMs": "57500",
        "words": "'Tis grace hath brought me safe thus far",
        "syllables": []
      },
      {
        "startTimeMs": "57500",
